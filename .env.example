# Copia este archivo a .env y completa tus valores.
# Si ANTHROPIC_API_KEY está vacío, el agente LangChain opera en modo simulado
# (sin costo) y el agente local funciona sin configurar nada.

# Clave de API de Anthropic (opcional, para LLM real)
ANTHROPIC_API_KEY=

# Modelo a usar cuando hay API key (opcional)
FERRANDES_MODEL=claude-sonnet-4-6